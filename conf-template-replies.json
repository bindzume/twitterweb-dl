{
    "extractor": {
        "base-directory": "{VAR_BASE_DIRECTORY}",
        "parent-directory": false,
        "postprocessors": null,
        "archive": null,
        "cookies": null,
        "cookies-update": true,
        "proxy": null,
        "skip": true,
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/115.0",
        "retries": 1,
        "timeout": 10,
        "verify": true,
        "fallback": true,
        "sleep": [0.5, 1.5],
        "sleep-request": [1, 3],
        "sleep-extractor": 0,
        "path-restrict": "auto",
        "path-replace": "_",
        "path-remove": "\\u0000-\\u001f\\u007f",
        "path-strip": "auto",
        "path-extended": true,
        "extension-map": {
            "jpeg": "jpg",
            "jpe": "jpg",
            "jfif": "jpg"
        },
        "twitter": {
            "text-tweets": true,
            "quoted": true,
            "retweets": true,
            "replies": true,
            "filename": "twitter_({VAR_USERNAME})_{date}_{tweet_id}-{num}.{extension}",
            "directory": {
                "": [
                    "twitter",
                    "{VAR_USERNAME}",
                    "replies"
                ]
            },
            "postprocessors": [
                {
                    "name": "metadata",
                    "event": "post",
                    "filename": "twitter_({VAR_USERNAME})_{date}_{tweet_id}_main.json"
                }
            ]
        }
    },
    "downloader": {
        "mtime": true,
        "part": true,
        "progress": 3,
        "retries": 4,
        "timeout": 30,
        "verify": true
    },
    "output": {
        "mode": "auto",
        "progress": true,
        "shorten": true,
        "skip": true
    }
}